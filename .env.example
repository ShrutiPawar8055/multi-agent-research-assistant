# All optional. With none of these set, ResearchCrew runs offline
# (local documents only, quoted answers, no LLM).

# Gemini API key (https://aistudio.google.com/apikey) ...
GOOGLE_API_KEY=
# ... or Vertex AI instead of a key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Live web search (https://tavily.com)
TAVILY_API_KEY=

# CREW_MODEL=gemini-2.5-flash
# CREW_DOCS_DIR=sample_docs
